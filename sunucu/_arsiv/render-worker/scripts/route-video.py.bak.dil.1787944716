# EŞ SÜRÜCÜLER (grup sürüş): mates dosyası VEYA legacy track2 tekil eşi -> ortak liste
_MATE_PALETTE=[("#FF9F0A","#FFD60A"),("#BF5AF2","#DA8FFF"),("#30D158","#66E27F"),
               ("#FF375F","#FF6482"),("#64D2FF","#9BE2FF"),("#FFD60A","#FFE566")]
def load_mates():
    out=[]
    if MATESF and os.path.exists(MATESF):
        try:
            for m in json.load(open(MATESF)) or []:
                if len(m.get("points") or [])>=2: out.append(m)
        except Exception as _em: print("mates okunamadı:",_em)
    elif TRACK2F and os.path.exists(TRACK2F):
        try:
            _p2=json.load(open(TRACK2F)).get("points",[])
            if len(_p2)>=2:
                out.append({"points":_p2,
                    "name":next((x.split("=",1)[1] for x in A if x.startswith("name2=")),""),
                    "line":next((x.split("=",1)[1] for x in A if x.startswith("line2=")),""),
                    "dot":next((x.split("=",1)[1] for x in A if x.startswith("dot2=")),"")})
        except Exception as _e2: print("track2 okunamadı:",_e2)
    for i,m in enumerate(out):
        pl=_MATE_PALETTE[i%len(_MATE_PALETTE)]
        if not m.get("line"): m["line"]=pl[0]
        if not m.get("dot"): m["dot"]=pl[1]
    return out
MATES_RAW=load_mates()
_mn=[m.get("name","").strip() for m in MATES_RAW if m.get("name","").strip()]
if _mn and NAME:
    NAME=(f"{NAME} & {_mn[0]}" if len(_mn)==1 else f"{NAME}, "+", ".join(_mn[:-1])+f" & {_mn[-1]}")
def compute_mates(Pn, FIDXn, FRn):
    """GRUP SÜRÜŞ: her eş sürücü için HER KARE pos önhesabı (kare -> track1 zamanı -> eş konumu).
    Renderer'lara saf [lon,lat] listeleri gider — motorlarda sıfır matematik, dilimler arası determinizm."""
    import bisect as _bi2
    outm=[]; Nn=len(Pn)
    for m in MATES_RAW:
        P2x=sorted([{"t":float(q["t"]),"lat":float(q["lat"]),"lon":float(q["lon"])} for q in m["points"]],key=lambda x:x["t"])
        _t2s=[q["t"] for q in P2x]
        def _pos2_at(tt):
            i=_bi2.bisect_left(_t2s,tt)
            if i<=0: a=b=P2x[0]; fr=0.0
            elif i>=len(P2x): a=b=P2x[-1]; fr=0.0
            else:
                a,b=P2x[i-1],P2x[i]; dt=b["t"]-a["t"]; fr=((tt-a["t"])/dt) if dt>0 else 0.0
            return [round(a["lon"]+(b["lon"]-a["lon"])*fr,6), round(a["lat"]+(b["lat"]-a["lat"])*fr,6)]
        def _fi2_at(tt):
            # v115: eş noktanın çizgi-üstü KESİRLİ İNDEKSİ doğrudan ZAMANDAN (lider FIDX mantığıyla aynı) —
            # geometrik izdüşüm firkete virajında segment atlayıp IŞINLIYORDU (Barış 2026-07-13 yakaladı)
            i=_bi2.bisect_left(_t2s,tt)
            if i<=0: return 0.0
            if i>=len(P2x): return float(len(P2x)-1)
            a,b=P2x[i-1],P2x[i]; dt=b["t"]-a["t"]
            return (i-1)+(((tt-a["t"])/dt) if dt>0 else 0.0)
        POS2x=[]; FI2x=[]
        for _f in range(FRn):
            _fi=FIDXn[_f]; _j=int(_fi); _jn=min(_j+1,Nn-1); _fr=_fi-_j
            _ft=Pn[_j]["t"]+(Pn[_jn]["t"]-Pn[_j]["t"])*_fr
            POS2x.append(_pos2_at(_ft)); FI2x.append(round(_fi2_at(_ft),4))
        outm.append({"pts2":[[q["lon"],q["lat"]] for q in P2x],"pos2":POS2x,"fi2":FI2x,
                     "line":m["line"],"dot":m["dot"]})
    if outm: print(f"GRUP SÜRÜŞ: {len(outm)} eş sürücü, kare-hizalı konumlar hazır")
    return outm
AVATARF=next((x.split("=",1)[1] for x in A if x.startswith("avatar=")),None)  # profil resmi (intro/outro Relive girişi)
def valid_mp4(path):
    # Render tam bitti mi? (moov atom = sonlandırılmış mp4). Yarım/bozuk dosya sunulmasın.
    try:
        if os.path.getsize(path) < 20000: return False
        with open(path,"rb") as fh: return b"moov" in fh.read()
    except Exception: return False
def sync_to_app():
    # videoyu hemen NickDegs2'ye (app'in okuduğu yere) senkronla
    try: subprocess.run(["systemctl","start","movelog-routes-sync.service"],timeout=120)
    except Exception as e: print("sync hata:",e)
def push_done():
    if NOTIFY:
        try: subprocess.run(["/usr/bin/python3","/opt/matrix/scripts/push.py",NOTIFY,"Videon hazır 🎬","Rota videon oluşturuldu, Rotalar'da."],timeout=30)
        except Exception as e: print("push hata:",e)
ACTLBL={"moto":"Motosiklet","car":"Araba","bike":"Bisiklet","run":"Koşu","walk":"Yürüyüş"}.get(ACTTYPE,"Sürüş")
# kullanici renkleri: dot=#hex (takip noktasi), line=#hex (rota cizgisi)
DOTC=next((x.split("=",1)[1] for x in A if x.startswith("dot=")),"#ff3b30")
LINEC=next((x.split("=",1)[1] for x in A if x.startswith("line=")),"#00e5ff")
CAMMODE=next((x.split("=",1)[1] for x in A if x.startswith("cam=")),"")   # 3d kamera: ""=eski yandan, "chase"=tam arkadan (google 3d'ye özel)
ULTRA=next((x.split("=",1)[1] for x in A if x.startswith("ultra=")),"")=="1"  # Ultra=Google foto-gerçekçi 3D; Premium=Mapbox 3D
SEG=next((x.split("=",1)[1] for x in A if x.startswith("seg=")),"")   # PARALEL SEGMENT: "k/n" -> bu worker k'inci kare dilimini render eder
LINE_ON = LINEC.lower() != "none"    # çizgisiz mod (sadece nokta)
def hex2rgb(h):
    h=h.lstrip("#")
    if len(h)<6: return (0,229,255)   # "none"/geçersiz -> güvenli varsayılan (çizim LINE_ON ile atlanır)
    return (int(h[0:2],16),int(h[2:4],16),int(h[4:6],16))
GLASS = LINEC.lower()=="glass"       # liquid glass: şeffaf frosted çizgi (yol hafif görünür, göze batmaz ama çık durur)
CLEAR = LINEC.lower()=="clear"       # renksiz tam şeffaf: en minimal cam (basit görünüm)
DOT=hex2rgb(DOTC); LINE=(245,248,252) if (GLASS or CLEAR) else hex2rgb(LINEC)
DEV=next((int(x.split("=",1)[1]) for x in A if x.startswith("dev=")),DEVICE)  # cihaz seç (1=sahip, 2=SEMRA, 3=ADEM)
ZOOMO=next((float(x.split("=",1)[1]) for x in A if x.startswith("zoom=")),None)  # 3B zoom override (uzun rota için geniş)
# KAMERA MESAFESİ (premium, her video): yakın/orta/uzak -> zoom kaydırması (yakın=daha yakın çekim).
CAMD=next((x.split("=",1)[1] for x in A if x.startswith("camdist=")),"orta")
# KİLİTLİ KAMERA KADEMELERİ (Barış 2026-08-28: "bütün zoomlar için kilitle").
# Tam kat farkı: her kademe bir öncekinin 2 katı yakın/uzak -> fark GÖZLE görülür.
