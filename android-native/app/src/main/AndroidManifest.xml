<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ağ durumu: TrackingService ağ geri geldiği an kuyruğu boşaltmak için
         registerDefaultNetworkCallback kullanıyor. İzin UYGULAMANIN KENDİ manifest'inde
         AÇIKÇA olmalı — eskiden yalnız firebase-messaging'in manifest'inden birleşiyordu,
         yani bağımlılık değişirse çevrimdışı tampon sessizce körleşirdi. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Kuyruk boşaltma işinin YENİDEN BAŞLATMAYI da aşması için: JobInfo.setPersisted(true)
         bu izin OLMADAN IllegalArgumentException atar. Şebekesiz yolculukta biriken noktalar
         telefon kapanıp açılsa bile diskte duruyor; iş de onlarla birlikte hayatta kalsın. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- ACCESS_BACKGROUND_LOCATION KALDIRILDI: rota kaydı foreground service ile çalışıyor,
         arka plan konum iznine gerek yok -> Play "arka plan konum" beyanı + demo video ZORUNLULUĞU kalkar. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 18.09: Telsiz (PTT) + canlı interkom KALDIRILDI -> mikrofon izinleri de kaldırıldı.
         Doğrulandı: AudioManager/MediaPlayer/TextToSpeech'in tek kullanıcısı silinen telsiz
         klibi çalma fonksiyonuydu; video oynatma media3/ExoPlayer ile çalışır, bu izinleri istemez. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".MoveLogApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Move Log"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MoveLog">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MoveLog">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.nickdegs.com" android:path="/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="movelog" android:host="invite" />
            </intent-filter>
        </activity>
        <service
            android:name=".TrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />
        <!-- Çevrimdışı konum kuyruğunun SİSTEM TETİĞİ (JobScheduler; WorkManager DEĞİL, yeni
             bağımlılık yok). Uygulama kapalı + takip kapalı + ağ yokken bile noktalar diskte
             bekler; ağ geri gelince sistem bu servisi uyandırır ve kuyruk akar.
             android:permission=BIND_JOB_SERVICE ZORUNLU: yoksa sistem işi hiç çalıştırmaz. -->
        <service
            android:name=".KuyrukIsi"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- FCM push bildirimleri (iOS APNs karşılığı) -->
        <service
            android:name=".MoveLogMessaging"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- PAYLAŞILABİLİR KART (26.10): sunucunun ürettiği PNG kartı başka uygulamalara (Instagram
             Story, WhatsApp...) vermek için. Yalnız cacheDir/kartlar/ açılır (res/xml/kart_paths.xml);
             authority Store.kartPaylas'taki packageName + ".kartlar" ile AYNI olmalı. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.kartlar"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/kart_paths" />
        </provider>
        <!-- Wear OS (Samsung saat) köprüsü: saatin kimlik isteğine cevap verir -->
        <service
            android:name=".PhoneWearService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/movelog" />
            </intent-filter>
        </service>
    </application>
</manifest>
